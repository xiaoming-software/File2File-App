#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

LIBRARY_SEARCH_PATHS=$(inherited) $(PROJECT_DIR)/../webrpc-sdk
// -Wl,-u,_Symbol keeps FFI C ABI exports from Release dead-code stripping.
OTHER_LDFLAGS[sdk=iphoneos*]=$(inherited) -force_load $(PROJECT_DIR)/../webrpc-sdk/libwebrpc-ios.a -lresolv -framework Security -framework CoreFoundation -framework SystemConfiguration -Wl,-u,_WebrpcClient_New -Wl,-u,_WebrpcClient_LoginStatus -Wl,-u,_WebrpcClient_GetReceivePort -Wl,-u,_WebrpcClient_OpenSession -Wl,-u,_WebrpcClient_CloseSession -Wl,-u,_WebrpcClient_SessionSize -Wl,-u,_WebrpcClient_TarTokenBySession -Wl,-u,_WebrpcClient_SendData -Wl,-u,_WebrpcClient_SendFile -Wl,-u,_WebrpcClient_SendFileAsync -Wl,-u,_WebrpcClient_Free
OTHER_LDFLAGS[sdk=iphonesimulator*]=$(inherited) -force_load $(PROJECT_DIR)/../webrpc-sdk/libwebrpc-ios-simulator.a -lresolv -framework Security -framework CoreFoundation -framework SystemConfiguration -Wl,-u,_WebrpcClient_New -Wl,-u,_WebrpcClient_LoginStatus -Wl,-u,_WebrpcClient_GetReceivePort -Wl,-u,_WebrpcClient_OpenSession -Wl,-u,_WebrpcClient_CloseSession -Wl,-u,_WebrpcClient_SessionSize -Wl,-u,_WebrpcClient_TarTokenBySession -Wl,-u,_WebrpcClient_SendData -Wl,-u,_WebrpcClient_SendFile -Wl,-u,_WebrpcClient_SendFileAsync -Wl,-u,_WebrpcClient_Free
STRIP_STYLE=non-global
