#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Link Go c-archive webrpc SDK (device arm64). Simulator needs a simulator-built .a.
OTHER_LDFLAGS=$(inherited) -force_load $(PROJECT_DIR)/../webrpc-sdk/libwebrpc-ios.a -lresolv -framework Security -framework CoreFoundation -framework SystemConfiguration
LIBRARY_SEARCH_PATHS=$(inherited) $(PROJECT_DIR)/../webrpc-sdk
